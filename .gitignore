# Local Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Credentials and local configuration
.env
.env.*
!.env.example
kaggle.json
*.pem
*.key

# Operating-system and editor files
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Official Kaggle downloads and simulator binaries
# These should be obtained directly from the competition resources
competition_data/

# Raw replay corpus and simulation outputs (large generated files)
scouting_replays/
top_player_replays/
tools/evaluation_decks/
tools/leaderboard_dump/

# Submission bundles and generated experiment traces
# Exclude everything in artifacts, but whitelist markdown reports and the two major submissions
artifacts/*
!artifacts/*.md
!artifacts/submission_11.tar.gz
!artifacts/submission_18.tar.gz

# Local logs and temporary files
*.log
*.tmp
*.tar
